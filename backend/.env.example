# 后端配置模板 —— 不含任何真实密钥，可安全提交到版本库。
#
# 注意：应用只读取“进程环境变量”，不会自动加载 .env 文件
#       （本项目刻意不引入 python-dotenv，以免增加依赖）。
# 使用方式示例：
#   PowerShell:  $env:BACKEND_PORT = "8000"; python app.py
#   bash:        BACKEND_PORT=8000 python app.py

# 监听地址与端口；接口标准要求 Base URL = http://127.0.0.1:8000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 运行环境标识，仅用于 /health 与 /api/v1/info 展示
BACKEND_ENV=development

# 生产/联调请保持 false；debug 模式会暴露 Flask 交互式调试器
BACKEND_DEBUG=false

# CRITICAL / ERROR / WARNING / INFO / DEBUG
BACKEND_LOG_LEVEL=INFO

# 日志文件路径；留空表示只输出到 stdout
BACKEND_LOG_FILE=

# 全局请求体上限（MB），超出返回 413 PAYLOAD_TOO_LARGE
BACKEND_MAX_UPLOAD_MB=512

# 运行期数据目录：SQLite 数据库 + 上传/登记的视频文件
# 默认 backend/var（已被 .gitignore 排除）；可指向仓库外的磁盘路径
BACKEND_DATA_DIR=C:\Projects\MiniCPM-V-CookBook\system_integration\backend\var

# 显式指定数据库文件；留空表示 <BACKEND_DATA_DIR>/app.db
BACKEND_DB_PATH=

# 数据目录下存放视频文件的子目录名
BACKEND_VIDEO_SUBDIR=videos

# 允许 POST /api/v1/videos/register 读取的目录，多个用分号分隔
# 留空表示只允许数据目录自身；不存在或未授权的路径会被拒绝
BACKEND_IMPORT_ROOTS=

# 仅测试用途，正常启动保持 false
BACKEND_TESTING=false

# 是否在启动时拉起后台任务线程（单线程串行队列）
# false 时任务会停留在 queued，需显式驱动（pytest 用 runner.run_until_idle() 驱动）
BACKEND_JOB_WORKER=true

# 视觉模型适配器实现：mock（占位）或 minicpm（真实 MiniCPM-V 4.6）
# 真实模式失败时不会回退到 mock，任务会直接失败
BACKEND_VLM_ADAPTER=mock

# 真实模型目录（权重不入库、不复制进 backend）
BACKEND_VLM_MODEL_PATH=C:\Projects\MiniCPM-V-CookBook\models\MiniCPM-V-4.6

# 推理设备；当前仅实现并验证 cuda（未提供 CPU 回退）
BACKEND_VLM_DEVICE=cuda

# 短视频采样策略：最多帧数 / 采样间隔（秒）/ 单任务最长处理时长（秒）
BACKEND_VLM_MAX_FRAMES=8
BACKEND_VLM_FRAME_INTERVAL_S=1.0
BACKEND_VLM_MAX_DURATION_S=60.0

# 每帧生成的最大 token 数
BACKEND_VLM_MAX_NEW_TOKENS=48


