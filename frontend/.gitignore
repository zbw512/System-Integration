# .gitignore

# Dependencies
node_modules/
.pnpm-store/
.yarn/

# Build output
dist/
build/
*.tsbuildinfo

# Vite cache
.vite/
node_modules/.vite/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage
coverage/
playwright-report/
test-results/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo