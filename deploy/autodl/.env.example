# Copy this file to .env on the AutoDL instance. Never commit .env.
# Generate with: openssl rand -hex 32
VLM_SERVICE_TOKEN=replace-with-at-least-32-random-characters

VLM_BASE_MODEL_PATH=/root/autodl-tmp/MiniCPM-V-4_5
VLM_ADAPTER_PATH=/root/autodl-tmp/checkpoint-600
VLM_HOST=127.0.0.1
VLM_PORT=18080
VLM_MAX_FRAMES=8

# 64 MiB request body, 16 MiB per PNG frame.
VLM_MAX_REQUEST_BYTES=67108864
VLM_MAX_FRAME_BYTES=16777216
VLM_MAX_IMAGE_PIXELS=16000000

VLM_LOAD_ON_STARTUP=true
VLM_LOG_LEVEL=INFO
